.env
.env.*
!.env.example

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Coverage / test artifacts
coverage/
.nyc_output/
.coverage

# Local tool state
.claude/
.codex/
.claude-octopus/
results/
.parallel-agents/

# Local cloned reference repositories
external_repos/

# Generated documentation (local dev only)
docs/
